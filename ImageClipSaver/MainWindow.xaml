<Window x:Class="ImageClipSaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImageClipSaver"
        Title="ImageClipSaver"
        Icon="app.ico"
        Width="760" Height="560" MinWidth="460" MinHeight="340"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static local:MainWindow.SavePending}" />
        <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DiscardPending}" />
        <KeyBinding Key="Escape" Command="{x:Static local:MainWindow.DiscardPending}" />
        <KeyBinding Key="A" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.ToggleCapture}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.ToggleReview}" />
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.ToggleTopmost}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static local:MainWindow.OpenFolder}" />
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.ShowAbout}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.SavePending}" Executed="SavePending_Executed" CanExecute="HasPending_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.DiscardPending}" Executed="DiscardPending_Executed" CanExecute="HasPending_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.ToggleCapture}" Executed="ToggleCapture_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.ToggleReview}" Executed="ToggleReview_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.ToggleTopmost}" Executed="ToggleTopmost_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenFolder}" Executed="OpenFolder_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.ShowAbout}" Executed="ShowAbout_Executed" />
    </Window.CommandBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Target folder -->
        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Left" Text="Save to" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,6" Command="{x:Static local:MainWindow.ShowAbout}"
                    ToolTip="About ImageClipSaver and updates (F1)" AutomationProperties.Name="About ImageClipSaver">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" />
            </Button>
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,6" Click="OpenFolder_Click"
                    ToolTip="Open the folder in File Explorer (Ctrl+O)">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" />
            </Button>
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,6" Click="ChooseFolder_Click"
                    ToolTip="Choose the folder that clips are saved in">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Margin="0,0,6,0" />
                    <TextBlock Text="Choose…" />
                </StackPanel>
            </Button>
            <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
        </DockPanel>

        <!-- Switches -->
        <WrapPanel Grid.Row="1" Margin="0,10,0,6">
            <ToggleButton x:Name="CaptureToggle" Style="{StaticResource ToggleSwitch}" Margin="0,0,20,4"
                          Content="Capture images" Click="Toggle_Click"
                          ToolTip="Listen for images on the clipboard (Ctrl+Shift+A)" />
            <ToggleButton x:Name="ReviewToggle" Style="{StaticResource ToggleSwitch}" Margin="0,0,20,4"
                          Content="Review before saving" Click="Toggle_Click"
                          ToolTip="Show each clip and let you decide whether to save it (Ctrl+Shift+R)" />
            <ToggleButton x:Name="TopmostToggle" Style="{StaticResource ToggleSwitch}" Margin="0,0,20,4"
                          Content="Keep on top" Click="Toggle_Click"
                          ToolTip="Keep this window above other windows (Ctrl+Shift+T)" />
        </WrapPanel>

        <!-- Preview -->
        <Border Grid.Row="2" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <TextBlock x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Take a screenshot (Win+Shift+S or Print Screen) or copy an image.&#x0a;It will show up here." />
                <Image x:Name="Preview" Margin="8" Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Border x:Name="PendingBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                        Padding="8,3" CornerRadius="4" Visibility="Collapsed"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="Not saved" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Status and review actions -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
            <StackPanel x:Name="PendingActions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                <Button Padding="12,6" Margin="6,0,0,0" Command="{x:Static local:MainWindow.DiscardPending}"
                        ToolTip="Throw this clip away (Esc or Delete)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" Margin="0,0,6,0" />
                        <TextBlock Text="Discard" />
                    </StackPanel>
                </Button>
                <Button Padding="12,6" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                        Command="{x:Static local:MainWindow.SavePending}"
                        ToolTip="Save this clip to the folder (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" Margin="0,0,6,0" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>
    </Grid>
</Window>
